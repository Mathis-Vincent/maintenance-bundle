{
  "name": "mathis-vincent/maintenance-bundle",
  "description": "A highly flexible and fully configurable Symfony bundle to handle multiple types of maintenance modes seamlessly.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": ["symfony", "bundle", "maintenance", "maintenance-mode"],
  "authors": [
    {
      "name": "Mathis Vincent",
      "email": "contact@mathis-vincent.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "MathisVincent\\MaintenanceBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MathisVincent\\MaintenanceBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
